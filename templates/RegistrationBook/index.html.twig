{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.registrationbook'|trans }}{% endblock %}
{% block description %}{{ 'registrationbook.directory.subtitle'|trans({}, 'messages') }}{% endblock %}

{% block content %}
<main class="guest-directory registration-directory"
      data-controller="registrationbook"
      data-registrationbook-search-url-value="{{ path('registrationbook.search') }}">
    <header class="guest-directory-heading">
        <div>
            <h1>{{ 'nav.registrationbook'|trans }}</h1>
            <p>{{ 'registrationbook.directory.subtitle'|trans({}, 'messages') }}</p>
        </div>
        <button type="button" class="guest-primary-button" id="openAdd"
                data-action="click->registrationbook#openAddReservationsAction"
                data-url="{{ path('registrationbook.showadd.reservations') }}"
                data-title="{{ 'registrationbook.addreservations'|trans }}"
                data-bs-toggle="modal" data-bs-target="#modalCenter">
            <i class="fas fa-plus" aria-hidden="true"></i> {{ 'registrationbook.addreservations'|trans }}
        </button>
    </header>
    <section class="guest-directory-panel" aria-label="{{ 'nav.registrationbook'|trans }}">
        <form class="guest-search" id="registrationbook-search-form"
              data-registrationbook-target="searchForm"
              data-action="submit->registrationbook#searchAction">
            <label class="visually-hidden" for="search">{{ 'registrationbook.directory.search'|trans({}, 'messages') }}</label>
            <div class="guest-search-input">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" class="form-control" id="search" name="search"
                       data-registrationbook-target="searchInput"
                       data-action="input->registrationbook#searchInputAction"
                       placeholder="{{ 'registrationbook.directory.search'|trans({}, 'messages') }}" value="{{ search }}">
            </div>
            <button class="guest-search-button" type="submit">{{ 'nav.customer.search'|trans }}</button>
        </form>
        <div id="reservationbook-table" data-registrationbook-target="table" aria-live="polite">
            {% include 'RegistrationBook/registrationbook_table.html.twig' %}
        </div>
    </section>
</main>
{% endblock %}
