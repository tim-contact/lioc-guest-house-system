{% extends 'base.html.twig' %}

{% block title %}{{ 'customer.directory.title'|trans({}, 'messages') }}{% endblock %}
{% block description %}{{ 'customer.directory.subtitle'|trans({}, 'messages') }}{% endblock %}

{% block content %}
<main class="guest-directory"
      data-controller="customers"
      data-customers-search-url-value="{{ path('customers.search') }}">
    <header class="guest-directory-heading">
        <div>
            <h1>{{ 'customer.directory.title'|trans({}, 'messages') }}</h1>
            <p>{{ 'customer.directory.subtitle'|trans({}, 'messages') }}</p>
        </div>
        <button type="button" class="guest-primary-button"
                data-action="click->customers#openModalAction"
                data-url="{{ path('customers.new.customer') }}"
                data-title="{{ 'nav.customer.add'|trans }}"
                data-bs-toggle="modal" data-bs-target="#modalCenter">
            <i class="fas fa-plus" aria-hidden="true"></i>
            {{ 'customer.directory.create'|trans({}, 'messages') }}
        </button>
    </header>

    <section class="guest-directory-panel" aria-label="{{ 'customer.directory.title'|trans({}, 'messages') }}">
        <form class="guest-search" id="customers-search-form"
              data-customers-target="searchForm" data-action="submit->customers#searchAction">
            <label class="visually-hidden" for="search">{{ 'customer.directory.search'|trans({}, 'messages') }}</label>
            <div class="guest-search-input">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" class="form-control" id="search" name="search"
                       data-customers-target="searchInput" data-action="input->customers#searchInputAction"
                       placeholder="{{ 'customer.directory.search'|trans({}, 'messages') }}" value="{{ search }}">
            </div>
            <button class="guest-search-button" type="submit">{{ 'nav.customer.search'|trans }}</button>
        </form>
        <div id="customers-table" data-customers-target="table" aria-live="polite">
            {% include 'Customers/customer_table.html.twig' %}
        </div>
    </section>
</main>
{% endblock %}
