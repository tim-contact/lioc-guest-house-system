<div class="table-responsive guest-table-scroll">
<table class="table guest-table align-middle">
    <thead><tr>
        <th class="guest-id">ID</th>
        <th>{{ 'customer.firstname'|trans }}</th>
        <th>{{ 'customer.lastname'|trans }}</th>
        <th>{{ 'customer.company'|trans }}</th>
        <th>{{ 'customer.count.books'|trans }}</th>
        <th>{{ 'customer.action'|trans }}</th>
    </tr></thead>
    <tbody>
    {% set hasGuests = false %}
    {% for customer in customers %}
        {% if customer.id != 0 %}
            {% set hasGuests = true %}
            <tr>
                <td class="guest-id">{{ customer.id }}</td>
                <td class="guest-name">{{ customer.firstname }}</td>
                <td class="guest-name">{{ customer.lastname }}</td>
                <td class="guest-company">
                    {% set hasCompany = false %}
                    {% for address in customer.customerAddresses %}
                        {% if address.company|length > 0 %}
                            {% if hasCompany %}<br>{% endif %}{{ address.company }}
                            {% set hasCompany = true %}
                        {% endif %}
                    {% endfor %}
                    {% if not hasCompany %}<span class="guest-muted">—</span>{% endif %}
                </td>
                <td><span class="guest-booking-count">{{ customer.bookedReservations|length }}</span></td>
                <td class="guest-actions">
                    <button type="button" class="guest-action-button"
                            title="{{ 'customer.directory.view'|trans({}, 'messages') }}"
                            aria-label="{{ 'customer.directory.view'|trans({}, 'messages') }}"
                            data-action="click->customers#openModalAction"
                            data-url="{{ path('customers.get.customer', {'id': customer.id}) }}"
                            data-title="{{ 'customer.details'|trans }}"
                            data-bs-toggle="modal" data-bs-target="#modalCenter"><i class="fas fa-info-circle" aria-hidden="true"></i></button>
                    <button type="button" class="guest-action-button"
                            title="{{ 'customer.directory.edit'|trans({}, 'messages') }}"
                            aria-label="{{ 'customer.directory.edit'|trans({}, 'messages') }}"
                            data-action="click->customers#openModalAction"
                            data-url="{{ path('customers.edit.customer.show', {'id': customer.id}) }}"
                            data-title="{{ 'customer.details'|trans }}"
                            data-bs-toggle="modal" data-bs-target="#modalCenter"><i class="fas fa-edit" aria-hidden="true"></i></button>
                </td>
            </tr>
        {% endif %}
    {% endfor %}
    {% if not hasGuests %}
        <tr><td colspan="6" class="guest-empty">{{ (search|default('')|trim ? 'customer.directory.empty_search' : 'customer.directory.empty')|trans({}, 'messages') }}</td></tr>
    {% endif %}
    </tbody>
</table>
</div>
<input id="page" type="hidden" name="page" value="{{ page }}" data-customers-target="page">
{% include 'paginator.html.twig' with { 'url': path('customers.overview'), 'pagination_action': 'click->customers#paginateAction' } %}
