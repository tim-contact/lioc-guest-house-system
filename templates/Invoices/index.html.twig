{% extends 'base.html.twig' %}

{% block title %}{{ 'invoice.directory.title'|trans({}, 'messages') }}{% endblock %}
{% block description %}{{ 'invoice.directory.subtitle'|trans({}, 'messages') }}{% endblock %}

{% block content %}
<main class="guest-directory invoice-directory" data-controller="invoices">
    <header class="guest-directory-heading">
        <div>
            <h1>{{ 'invoice.directory.title'|trans({}, 'messages') }}</h1>
            <p>{{ 'invoice.directory.subtitle'|trans({}, 'messages') }}</p>
        </div>
        <div class="invoice-heading-actions">
            <button type="button" class="guest-primary-button" data-action="click->invoices#openModalAction"
                    data-url="{{ path('invoices.new.invoice') }}" data-create-new="true"
                    data-title="{{ 'invoice.select.open.reservation'|trans }}"
                    data-bs-toggle="modal" data-bs-target="#modalCenter">
                <i class="fas fa-plus" aria-hidden="true"></i> {{ 'nav.invoice.add'|trans }}
            </button>
            <button type="button" class="guest-action-button" title="{{ 'invoice.settings.text'|trans }}"
                    aria-label="{{ 'invoice.settings.text'|trans }}"
                    data-url="{{ path('invoices.settings.get') }}" data-bs-toggle="modal" data-bs-target="#modalCenter"
                    data-action="click->invoices#openModalAction">
                <i class="fas fa-cog" aria-hidden="true"></i>
            </button>
        </div>
    </header>
    <section class="guest-directory-panel" aria-label="{{ 'invoice.directory.title'|trans({}, 'messages') }}">
        <form class="guest-search" id="invoices-search-form" data-search-url="{{ path('invoices.search') }}"
              data-action="submit->invoices#doSearchAction" novalidate>
            <label class="visually-hidden" for="search">{{ 'invoice.directory.search'|trans({}, 'messages') }}</label>
            <div class="guest-search-input">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" class="form-control" id="search" name="search"
                       placeholder="{{ 'invoice.directory.search'|trans({}, 'messages') }}" value="{{ search }}"
                       data-action="keyup->invoices#searchInputAction">
            </div>
            <button class="guest-search-button" type="submit">{{ 'nav.customer.search'|trans }}</button>
        </form>
        <div id="invoice-table" aria-live="polite">
            {% include 'Invoices/invoice_table.html.twig' %}
        </div>
    </section>
</main>
{% endblock %}
