<aside class="lioc-briefing" aria-labelledby="daily-briefing-title">
    {% if is_granted('ROLE_RESERVATIONS') %}
        <button type="button" class="btn lioc-new-reservation"
                data-action="click->reservations#selectAppartmentAction"
                data-reservations-create-new="true"
                data-url="{{ path('reservations.select.appartment', {object: objectId}) }}"
                data-bs-toggle="modal" data-bs-target="#modalCenter">
            <span aria-hidden="true">+</span> {{ 'reservation.overview.new_reservation'|trans }}
        </button>
    {% endif %}
    {% set cardDate = overview.date %}
    {% set monthStart = cardDate|date_modify('first day of this month') %}
    {% set firstWeekday = monthStart|date('w') + 0 %}
    {% set monthDays = cardDate|date('t') + 0 %}
    {% set selectedDay = cardDate|date('j') + 0 %}
    <div class="lioc-date-lockup lioc-paper-calendar"
         data-controller="reservation-date-card"
         data-reservation-date-card-displayed-value="{{ cardDate|date('Y-m-d', 'UTC') }}"
         data-reservation-date-card-server-time-value="{{ 'now'|date('U') }}"
         role="img" aria-label="{{ getLocalizedDate(cardDate, 'EEEE, d MMMM y', app.request.locale) }}">
        <div class="lioc-paper-calendar__binding" aria-hidden="true"><span></span><span></span></div>
        <div class="lioc-paper-calendar__markers" aria-hidden="true"><span></span><span></span></div>
        <div class="lioc-paper-calendar__day" aria-hidden="true">{{ cardDate|date('d') }}</div>
        <div class="lioc-paper-calendar__date" aria-hidden="true">
            <strong>{{ weekdayLabels[cardDate|date('N')] }}</strong>
            <span>{{ getLocalizedMonth(cardDate|date('n'), 'MMM', app.request.locale) }}</span>
            <span>{{ cardDate|date('Y') }}</span>
        </div>
        <div class="lioc-paper-calendar__month" aria-hidden="true">
            <div class="lioc-paper-calendar__month-title">{{ getLocalizedMonth(cardDate|date('n'), 'MMM', app.request.locale) }} {{ cardDate|date('Y') }}</div>
            <div class="lioc-paper-calendar__grid">
                {% for weekday in [7, 1, 2, 3, 4, 5, 6] %}
                    <span class="lioc-paper-calendar__weekday">{{ weekdayLabels[weekday]|first|upper }}</span>
                {% endfor %}
                {% for cell in 0..41 %}
                    {% set day = cell - firstWeekday + 1 %}
                    <span class="lioc-paper-calendar__cell{% if day == selectedDay %} lioc-paper-calendar__cell--selected{% endif %}">{% if day >= 1 and day <= monthDays %}{{ day }}{% endif %}</span>
                {% endfor %}
            </div>
        </div>
    </div>

    <section class="lioc-briefing-section" aria-labelledby="daily-briefing-title">
        <h3 id="daily-briefing-title">{{ 'reservation.overview.briefing.arrivals'|trans }}</h3>
        {% if overview.arrivals is empty %}
            <p class="lioc-empty-state">{{ 'reservation.overview.briefing.no_arrivals'|trans }}</p>
        {% else %}
            <div class="lioc-arrival-list">
                {% for arrival in overview.arrivals %}
                    <button type="button" class="lioc-arrival"
                            data-action="click->reservations#openReservationAction"
                            data-reservation-id="{{ arrival.reservationId }}"
                            data-url="{{ path('reservations.get.reservation', {id: arrival.reservationId}) }}">
                        <span class="lioc-arrival-time">{{ 'reservation.overview.briefing.arriving'|trans }}</span>
                        <span class="lioc-arrival-main">
                            <strong>{{ arrival.guestName ?: 'reservation.overview.unnamed_guest'|trans }}</strong>
                            <span>{{ arrival.roomNumber }} · {{ 'reservation.overview.guests_count'|trans({'%count%': arrival.guestCount}) }}</span>
                        </span>
                        <span class="lioc-status-pill">{{ arrival.statusName }}</span>
                    </button>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="lioc-briefing-section lioc-housekeeping" aria-labelledby="housekeeping-title">
        <h3 id="housekeeping-title">{{ 'reservation.overview.briefing.housekeeping'|trans }}</h3>
        {% if overview.housekeepingRooms is empty %}
            <p class="lioc-empty-state">{{ 'reservation.overview.briefing.no_rooms'|trans }}</p>
        {% else %}
            <ul class="lioc-housekeeping-list">
                {% for room in overview.housekeepingRooms %}
                    {% set state = room.housekeepingStatus ?: room.occupancyType %}
                    {% set stateKey = room.housekeepingStatus
                        ? 'housekeeping.status.' ~ room.housekeepingStatus|lower
                        : 'housekeeping.occupancy.' ~ room.occupancyType|lower %}
                    <li>
                        <span class="lioc-room-dot lioc-room-dot--{{ state|lower|replace({'_': '-'}) }}" aria-hidden="true"></span>
                        <span class="lioc-housekeeping-room">
                            <strong>{{ room.roomNumber }}</strong>
                            <span>{{ room.roomType }}</span>
                        </span>
                        <span class="lioc-housekeeping-state">{{ stateKey|trans({}, 'Housekeeping') }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</aside>
