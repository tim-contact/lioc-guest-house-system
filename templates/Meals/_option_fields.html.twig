<div class="col-md-3"><label class="form-label" for="meal-name-{{ prefix }}">{{ 'meals.item'|trans({}, 'Meals') }}</label><input class="form-control" id="meal-name-{{ prefix }}" name="name" maxlength="120" value="{{ option ? option.name : '' }}" required></div>
<div class="col-md-2"><label class="form-label" for="meal-service-{{ prefix }}">{{ 'meals.service'|trans({}, 'Meals') }}</label><input class="form-control" id="meal-service-{{ prefix }}" name="service" maxlength="40" value="{{ option ? option.service : '' }}" required></div>
<div class="col-md-2"><label class="form-label" for="meal-price-{{ prefix }}">{{ 'meals.price'|trans({}, 'Meals') }}</label><input class="form-control" type="number" min="0" step="0.01" id="meal-price-{{ prefix }}" name="price" value="{{ option ? (option.priceMinor / 100)|number_format(2, '.', '') : '' }}" required></div>
<div class="col-md-1"><label class="form-label" for="meal-currency-{{ prefix }}">{{ 'meals.currency'|trans({}, 'Meals') }}</label><input class="form-control" id="meal-currency-{{ prefix }}" name="currency" maxlength="3" value="{{ option ? option.currency : '' }}" required></div>
<div class="col-md-2"><label class="form-label" for="meal-tax-{{ prefix }}">{{ 'meals.tax_rate'|trans({}, 'Meals') }}</label><input class="form-control" type="number" min="0" max="100" step="0.01" id="meal-tax-{{ prefix }}" name="taxRate" value="{{ option ? option.taxRate : '' }}" required></div>
<div class="col-md-2"><label class="form-label" for="meal-taxmode-{{ prefix }}">{{ 'meals.tax_mode'|trans({}, 'Meals') }}</label><select class="form-select" id="meal-taxmode-{{ prefix }}" name="taxMode"><option value="included"{{ option and option.includesTax ? ' selected' : '' }}>{{ 'meals.tax_included'|trans({}, 'Meals') }}</option><option value="added"{{ option and option.includesTax is same as(false) ? ' selected' : '' }}>{{ 'meals.tax_added'|trans({}, 'Meals') }}</option></select></div>
